{
  "compilerOptions": {
    "module": "commonjs",
    "target": "es2022",
    "outDir": "./dist",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": [
    "src/**/*",
    "bin/**/*.ts",
    "install.ts",
    "tests/**/*",
    "types/**/*.d.ts"
  ]
}
